# ---- build artifacts ----
engine/build/
/bin/
*.exe
*.obj
*.o
*.a
*.lib

# ---- toolchain & vendored engines (restored via scripts/fetch_lvgl.ps1) ----
/toolchain/
engine/vendor/
/runtime/

