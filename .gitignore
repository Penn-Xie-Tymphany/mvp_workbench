engine/ui_import/*/
!engine/ui_import/.active_project

# ---- per-project junctions pointing into engine/ui_import ----
projects/*/ui/

# ---- python ----
__pycache__/
*.pyc
*.pyo

# ---- OS / editor ----
Thumbs.db
.DS_Store
*.tmp
